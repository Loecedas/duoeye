---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const { 
  title, 
  description = "DuoEye - 一个基于 Astro + React 的多邻国学习数据分析仪表盘，提供详尽的今日概览、学习趋势分析、年度热力图、成就徽章点亮、语种精力分布以及 AI 导师个性化学习点评。",
  robots = "index, follow"
} = Astro.props;

const host = Astro.request.headers.get('x-forwarded-host') || Astro.request.headers.get('host') || Astro.url.host;
const protocol = Astro.request.headers.get('x-forwarded-proto') || 'https';
const siteUrl = import.meta.env.SITE_URL || `${protocol}://${host}`;
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();

// Google 搜索结果中展示的网站结构化数据 (JSON-LD WebSite)
// 这对于确保搜索引擎（尤其是 Google）能够正确读取和在搜索结果中显示网站的名字标签 (DuoEye) 至关重要。
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "DuoEye",
  "alternateName": ["多邻国学习数据仪表盘", "DuoEye多邻国仪表盘", "DuoEye Duolingo Dashboard"],
  "url": siteUrl
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta name="google-site-verification" content="-kGupQiQrr-uWtp_ewcZMSTRsL-35RuuyyBhym-WO7g" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        function applyTheme() {
          try {
            const savedTheme = localStorage.getItem('duoeye-theme');
            const themeMode = savedTheme === 'light' || savedTheme === 'dark' || savedTheme === 'system' ? savedTheme : 'system';
            const isDark = themeMode === 'system'
              ? window.matchMedia('(prefers-color-scheme: dark)').matches
              : themeMode === 'dark';

            const root = document.documentElement;
            if (isDark) {
              root.classList.add('dark');
              root.style.backgroundColor = '#1c1c1e';
              root.style.colorScheme = 'dark';
            } else {
              root.classList.remove('dark');
              root.style.backgroundColor = '#f5f5f7';
              root.style.colorScheme = 'light';
            }

            const savedEmojiMode = localStorage.getItem('duoeye_emoji_icon_mode');
            if (savedEmojiMode === 'svg') {
              root.classList.add('duo-mode-svg');
            } else {
              root.classList.remove('duo-mode-svg');
            }
          } catch (e) {}
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <ViewTransitions />
    
    <!-- SEO & Indexing Optimization -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robots} />
    
    <!-- App Name for Browsers & Mobile Shortcuts -->
    <meta name="application-name" content="DuoEye" />
    <meta name="apple-mobile-web-app-title" content="DuoEye" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="DuoEye" />
    <meta property="og:image" content={new URL('/android-chrome-512x512.png', siteUrl).toString()} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/android-chrome-512x512.png', siteUrl).toString()} />

    <!-- Favicons & Mobile Icons -->
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Structured Data (JSON-LD) for Search Results Name Label -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body class="min-h-screen font-sans antialiased text-apple-dark1 dark:text-white">
    <slot />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-variant-numeric: lining-nums !important;
    font-feature-settings: "lnum" !important;
  }

  :root {
    color-scheme: light;
    --duo-green: #58CC02;
    --duo-green-dark: #46A302;
    --duo-blue: #1CB0F6;
    --duo-blue-dark: #1899D6;
    --duo-purple: #A572F7;
    --duo-red: #FF4B4B;
    --duo-yellow: #FFC800;
    --duo-orange: #FF9600;
  }

  /* By default, hide SVG emojis and show native ones */
  .duo-emoji-svg { display: none !important; }
  .duo-emoji-native { display: inline-flex !important; }

  /* If inside a container with .duo-mode-svg, hide native and show SVG emojis */
  .duo-mode-svg .duo-emoji-native { display: none !important; }
  .duo-mode-svg .duo-emoji-svg { display: inline-flex !important; }

  html.dark {
    color-scheme: dark;
  }

  html {
    font-family: "Times New Roman", SimSun, "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    background: #f5f5f7;
    scroll-padding-top: 8rem;
    scroll-behavior: smooth;
  }

  html.dark {
    background: #1c1c1e;
  }

  @media (min-width: 640px) {
    html {
      scroll-padding-top: 9rem;
    }
  }

  body {
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(88, 204, 2, 0.05), transparent 22%),
      radial-gradient(circle at top right, rgba(28, 176, 246, 0.05), transparent 20%),
      linear-gradient(180deg, #fbfbfd 0%, #f5f5f7 45%, #f7f7fa 100%);
  }

  html.dark body {
    background:
      radial-gradient(circle at top left, rgba(88, 204, 2, 0.06), transparent 20%),
      radial-gradient(circle at top right, rgba(28, 176, 246, 0.06), transparent 20%),
      linear-gradient(180deg, #141416 0%, #1c1c1e 50%, #151517 100%);
  }

  ::selection {
    background: rgba(28, 176, 246, 0.18);
  }

  ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  ::-webkit-scrollbar-thumb {
    background: rgba(120, 120, 128, 0.28);
    border-radius: 999px;
    border: 2px solid transparent;
    background-clip: padding-box;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  button,
  input,
  textarea {
    font: inherit;
  }

  .chart-shell {
    -webkit-tap-highlight-color: transparent;
  }

  .chart-shell :focus:not(:focus-visible) {
    outline: none !important;
    box-shadow: none !important;
  }

  .chart-shell :focus-visible {
    outline: 2px solid rgba(28, 176, 246, 0.32) !important;
    outline-offset: 2px;
  }

  .render-isolate {
    contain: layout;
    isolation: isolate;
  }

  .deferred-section {
    content-visibility: auto;
    contain-intrinsic-size: 960px;
  }

  html.animations-off {
    scroll-behavior: auto !important;
  }

  html.animations-off .animate-fade-in-up {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

  html.animations-off button,
  html.animations-off a,
  html.animations-off [role="button"],
  html.animations-off .group,
  html.animations-off nav {
    transition: none !important;
  }

  html.animations-off button:hover,
  html.animations-off a:hover,
  html.animations-off [role="button"]:hover,
  html.animations-off [class*='hover:-translate']:hover,
  html.animations-off [class*='hover:translate']:hover,
  html.animations-off [class*='hover:scale']:hover,
  html.animations-off [class*='group-hover:-translate'],
  html.animations-off [class*='group-hover:translate'],
  html.animations-off [class*='group-hover:scale'] {
    transform: none !important;
  }
</style>
